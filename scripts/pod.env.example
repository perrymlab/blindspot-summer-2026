# Pod connection settings for the annotation helper scripts
# (fetch_annotation_videos.sh and save_annotations.sh).
#
# SETUP (one time):
#   cp scripts/pod.env.example scripts/pod.env
# then edit scripts/pod.env and fill in the two values below.
#
# A RunPod pod gets a NEW host and port every time it restarts, so update
# these after each restart. Find them in the RunPod console under
# Connect -> SSH. For example, this connect command:
#   ssh root@203.0.113.5 -p 40123 -i ~/.ssh/id_ed25519
# means:  POD_HOST=root@203.0.113.5   POD_PORT=40123
#
# scripts/pod.env is gitignored, so your edits stay on this machine only.

POD_HOST=root@CHANGE_ME
POD_PORT=CHANGE_ME

# Optional -- only set these if your layout differs from the defaults:
# POD_KEY=$HOME/.ssh/id_ed25519                # SSH private key
# POD_DATA=/workspace/blindspot_data           # remote footage root (fetch)
# POD_REPO=/workspace/blindspot-summer-2026    # remote repo path (save upload)
# ANNOTATION_DIR=$HOME/annotation              # local annotation output dir
